<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Norns</title>
    <link rel="stylesheet" href="/assets/app.css" />
    <script>
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-200 min-h-screen">
    <%= @inner_content %>
    <script src="/assets/phoenix.min.js">
    </script>
    <script src="/assets/phoenix_live_view.min.js">
    </script>
    <script>
      let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
      // Rewrites server-rendered UTC timestamps in the viewer's timezone and locale.
      const timeFormats = {
        datetime: new Intl.DateTimeFormat(undefined, {
          year: "numeric", month: "2-digit", day: "2-digit",
          hour: "2-digit", minute: "2-digit", second: "2-digit"
        }),
        time: new Intl.DateTimeFormat(undefined, {
          hour: "2-digit", minute: "2-digit", second: "2-digit", fractionalSecondDigits: 3
        })
      };
      const LocalTime = {
        mounted() { this.render(); },
        updated() { this.render(); },
        render() {
          let date = new Date(this.el.getAttribute("datetime"));
          let format = timeFormats[this.el.dataset.format] || timeFormats.datetime;
          if (!isNaN(date)) this.el.textContent = format.format(date);
        }
      };

      let liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
        longPollFallbackMs: 2500,
        params: { _csrf_token: csrfToken },
        hooks: { LocalTime }
      });
      liveSocket.connect();

      window.toggleTheme = function() {
        let isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      }
    </script>
  </body>
</html>
